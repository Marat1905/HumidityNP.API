{
  "Authorization": {
    "Keycloak": {
      "Realm": "humidity-realm",
      "AuthServerUrl": "http://keycloak:8080",
      "MetadataAddress": "http://keycloak:8080/realms/humidity-realm/.well-known/openid-configuration",
      "RequireHttpsMetadata": false,
      "ValidateIssuer": true,
      "ValidateAudience": true,
      "ValidAudiences": [
        "account",
        "humidity-api-client"
      ],
      "ValidateLifetime": true,
      "ValidateIssuerSigningKey": true
    }
  },
  "AuthorizationPolicies": {
    "DiagnostPolicy": [ "Admin", "Diagnost" ],
    "ServicePolicy": [ "Admin", "Diagnost", "Service" ],
    "ManagerPolicy": [ "Manager", "Admin" ],
    "AdminPolicy": [ "Manager", "Admin" ],
    "SafetyPolicy": [ "Safety", "Admin" ],
    "Electro": [ "Electric", "Admin" ],
    "TCXPolicy": [ "TCX", "Admin" ]
  }
}