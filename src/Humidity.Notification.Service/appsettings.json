{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "MongoDb": {
    "ConnectionString": "mongodb://mongo:mongo@localhost:27017",
    "DatabaseName": "humidity_notifications",
    "NotificationsCollection": "notification_logs"
  },

  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "Username": "humidity",
    "Password": "humidity",
    "VirtualHost": "/",
    "MaxRetries": 3
  },

  "Smtp": {
    "Host": "localhost",
    "Port": 1025,
    "From": "humidity@local",
    "Username": "",
    "Password": "",
    "UseSsl": false
  },

  "Recipients": {
    "Default": "dispatcher@example.com,manager@example.com"
  },

  "HumidityApi": {
    "GrpcAddress": "http://localhost:5001"
  },

  "TimeZoneId": "Ekaterinburg Standard Time",

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  }
}