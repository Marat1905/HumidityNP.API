{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },

  "AllowedHosts": "*",

  "Keycloak": {
    "Authority": "http://keycloak:8080/realms/humidity",
    "MetadataAddress": "http://keycloak:8080/realms/humidity/.well-known/openid-configuration",
    "RequireHttpsMetadata": false
  },

  "ReverseProxy": {
    "Routes": {
      "humidity-api-route": {
        "ClusterId": "humidity-api",
        "Match": {
          "Path": "/humidity/api/{**catch-all}"
        }
      },
      "signalr-route": {
        "ClusterId": "humidity-api",
        "Match": {
          "Path": "/hubs/{**catch-all}"
        }
      },
      "notification-rest-route": {
        "ClusterId": "notification-service",
        "Match": {
          "Path": "/humidity/notifications/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/humidity/notifications" }
        ]
      },
      "notification-health-route": {
        "ClusterId": "notification-service",
        "Match": {
          "Path": "/humidity/notifications-health/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/humidity/notifications-health" }
        ]
      }
    },
    "Clusters": {
      "humidity-api": {
        "Destinations": {
          "primary": {
            "Address": "http://api:8080/"
          }
        }
      },
      "notification-service": {
        "Destinations": {
          "primary": {
            "Address": "http://notification:8080/"
          }
        }
      }
    }
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Yarp": "Information"
      }
    }
  }
}