{
  "realm": "humidity",
  "enabled": true,
  "displayName": "Humidity Control",
  "accessTokenLifespan": 900,
  "accessTokenLifespanForImplicitFlow": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "offlineSessionIdleTimeout": 2592000,
  "offlineSessionMaxLifespanEnabled": false,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "rememberMe": true,
  "verifyEmail": false,
  "loginTheme": "keycloak",
  "internationalizationEnabled": true,
  "supportedLocales": [ "ru", "en" ],
  "defaultLocale": "ru",
  "sslRequired": "none",
  "roles": {
    "realm": [
      {
        "name": "User",
        "description": "Обычный пользователь (просмотр)"
      },
      {
        "name": "TCX",
        "description": "Технолог-контролёр (создание/редактирование)"
      },
      {
        "name": "Admin",
        "description": "Администратор"
      },
      {
        "name": "Manager",
        "description": "Руководитель"
      },
      {
        "name": "Safety",
        "description": "Охрана труда"
      },
      {
        "name": "Electric",
        "description": "Электрик"
      },
      {
        "name": "Diagnost",
        "description": "Диагност"
      },
      {
        "name": "Service",
        "description": "Сервисный инженер"
      }
    ]
  },
  "clients": [
    {
      "clientId": "humidity-frontend",
      "name": "Humidity Frontend (React)",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "consentRequired": false,
      "fullScopeAllowed": true,
      "frontchannelLogout": true,
      "rootUrl": "http://localhost:3000",
      "adminUrl": "http://localhost:3000",
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:3000/humidity",
        "http://localhost:3000/humidity/*",
        "http://localhost:8090/*",
        "http://localhost:8090/humidity",
        "http://localhost:8090/humidity/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://localhost:8090"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*##http://localhost:3000/humidity##http://localhost:8090/*##http://localhost:8090/humidity",
        "backchannel.logout.session.required": "true",
        "backchannel.logout.revoke.offline.tokens": "false"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email",
        "basic"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ]
    },
    {
      "clientId": "humidity-api",
      "name": "Humidity API (backend)",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "humidity-gateway",
      "name": "YARP Gateway",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "humidity-notification-service",
      "name": "Notification Service",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    }
  ],
  "users": [
    {
      "username": "user",
      "enabled": true,
      "email": "user@example.com",
      "emailVerified": true,
      "firstName": "Иван",
      "lastName": "Иванов",
      "credentials": [
        {
          "type": "password",
          "value": "user",
          "temporary": false
        }
      ],
      "realmRoles": [ "User" ],
      "requiredActions": []
    },
    {
      "username": "tcx",
      "enabled": true,
      "email": "tcx@example.com",
      "emailVerified": true,
      "firstName": "Пётр",
      "lastName": "Петров",
      "credentials": [
        {
          "type": "password",
          "value": "tcx",
          "temporary": false
        }
      ],
      "realmRoles": [ "TCX", "User" ],
      "requiredActions": []
    },
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@example.com",
      "emailVerified": true,
      "firstName": "Сидор",
      "lastName": "Сидоров",
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ],
      "realmRoles": [ "Admin", "TCX", "User", "Manager" ],
      "requiredActions": []
    }
  ]
}